# Données du dashboard AQI - variables d'environnement

## Base de données (Neon) utilisée par app.py en local
# Pour le déploiement Streamlit Cloud : Settings > Secrets, format :
#   [neon]
#   host = "..."
#   port = "5432"
#   db = "neondb"
#   user = "..."
#   password = "..."
#   sslmode = "require"
POSTGRES_HOST=ep-cold-sun-ag3ww3w3-pooler.c-2.eu-central-1.aws.neon.tech
POSTGRES_PORT=5432
POSTGRES_DB=neondb
POSTGRES_USER=neondb_owner
POSTGRES_PASSWORD=your_password_here
POSTGRES_SSL=require
